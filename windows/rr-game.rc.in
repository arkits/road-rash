// Plan 33b Task 3: rr-game.exe icon and version resources. The icon is the
// committed assets/app-icon/roadrash.ico (owner exception; see its README).
#include <winver.h>
#include "rr_build_version.h"

1 ICON "@RR_APP_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION RR_VERSION_MAJOR,RR_VERSION_MINOR,RR_VERSION_PATCH,0
 PRODUCTVERSION RR_VERSION_MAJOR,RR_VERSION_MINOR,RR_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Road Rash Native"
            VALUE "FileVersion", RR_VERSION_STRING
            VALUE "InternalName", "rr-game"
            VALUE "OriginalFilename", "rr-game.exe"
            VALUE "ProductName", "Road Rash Native"
            VALUE "ProductVersion", RR_PRODUCT_VERSION_STRING
            VALUE "Comments", "Native port; plays from the owner's own 1997 Road Rash disc"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
